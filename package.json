{
  "name": "@avesd/workspace",
  "private": true,
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "build": "turbo build",
    "compile": "turbo compile",
    "depcheck": "pnpm outdated -r --include-github-actions",
    "dev": "pnpm --filter @avesd/desktop dev",
    "iud": "node scripts/dependencies/maintenance.mjs iud",
    "lint": "eslint scripts test eslint.config.mjs && turbo lint && pnpm validate-repository-boundaries && pnpm check:workflows",
    "self-update": "pnpm update-self",
    "test": "node --test test/unit/scripts/*/*.test.mjs && turbo test",
    "test:electron": "pnpm build && pnpm --filter @avesd/desktop test:electron",
    "ud": "node scripts/dependencies/maintenance.mjs ud",
    "update-all": "node scripts/dependencies/maintenance.mjs update-all",
    "validate-repository-boundaries": "node --check scripts/validate-repository-boundaries.mjs && node scripts/validate-repository-boundaries.mjs",
    "validate": "pnpm lint && pnpm compile && pnpm test && pnpm build",
    "update-dependencies": "node scripts/dependencies/maintenance.mjs update-dependencies",
    "update-actions": "node scripts/dependencies/maintenance.mjs update-actions",
    "update-self": "node scripts/dependencies/maintenance.mjs update-self",
    "sort-dependencies": "node scripts/dependencies/maintenance.mjs sort-dependencies",
    "sort-workspace": "node scripts/dependencies/maintenance.mjs sort-workspace",
    "sort-all": "node scripts/dependencies/maintenance.mjs sort-all",
    "lint:fix": "eslint scripts test eslint.config.mjs --fix && pnpm -r --if-present lint:fix && pnpm validate-repository-boundaries && pnpm check:workflows",
    "check:workflows": "node scripts/validation/workflows.mjs"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
