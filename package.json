{
  "name": "@avesd/workspace",
  "private": true,
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "build": "turbo build",
    "compile": "tsc --noEmit -p scripts/tsconfig.json && turbo compile",
    "depcheck": "pnpm outdated -r --include-github-actions",
    "dev": "pnpm --filter @avesd/desktop dev",
    "iud": "node scripts/dependencies/maintenance.mjs iud",
    "lint": "pnpm check:file-headers && eslint scripts eslint.config.mjs && turbo lint && pnpm validate-repository-boundaries && pnpm check:workflows && pnpm version-dry-run",
    "self-update": "pnpm update-self",
    "ud": "node scripts/dependencies/maintenance.mjs ud",
    "update-all": "node scripts/dependencies/maintenance.mjs update-all",
    "validate-repository-boundaries": "node --check scripts/validate-repository-boundaries.mjs && node scripts/validate-repository-boundaries.mjs",
    "validate": "pnpm lint && pnpm compile && pnpm build",
    "update-dependencies": "node scripts/dependencies/maintenance.mjs update-dependencies",
    "update-actions": "node scripts/dependencies/maintenance.mjs update-actions",
    "update-self": "node scripts/dependencies/maintenance.mjs update-self",
    "sort-dependencies": "node scripts/dependencies/maintenance.mjs sort-dependencies",
    "sort-workspace": "node scripts/dependencies/maintenance.mjs sort-workspace",
    "sort-all": "node scripts/dependencies/maintenance.mjs sort-all",
    "lint:fix": "pnpm fix:file-headers && eslint scripts eslint.config.mjs --fix && pnpm -r --if-present lint:fix && pnpm validate-repository-boundaries && pnpm check:workflows && pnpm version-dry-run",
    "check:file-headers": "node scripts/validation/file-headers.ts check",
    "fix:file-headers": "node scripts/validation/file-headers.ts fix",
    "test:file-headers": "node --test scripts/test/unit/validation/file-headers.test.ts",
    "test:dependency-sorting": "node --test scripts/test/unit/dependencies/sorting.test.ts",
    "check:workflows": "node scripts/validation/workflows.mjs",
    "changeset": "node scripts/release/release-changesets.ts add",
    "version-dry-run": "node scripts/release/release-changesets.ts plan",
    "version-packages": "node scripts/release/release-changesets.ts apply"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "type": "module"
}
