{
  "name": "@avesd/desktop",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "compile": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dev": "electron-vite dev",
    "lint": "eslint .",
    "preview": "electron-vite preview",
    "lint:fix": "eslint . --fix",
    "test:run": "node --import ./test/register-typescript.mjs --test",
    "test": "node --import ./test/register-typescript.mjs --test 'test/unit/**/*.test.ts' 'test/integration/**/*.test.ts'"
  },
  "dependencies": {
    "@avesd/plugin-api": "workspace:*",
    "@avesd/workspace-model": "workspace:*",
    "@modelcontextprotocol/server": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@avesd/renderer-settings": "workspace:*",
    "@avesd/desktop-contracts": "workspace:*",
    "@avesd/renderer-controller": "workspace:*",
    "@avesd/renderer-canvas": "workspace:*"
  },
  "devDependencies": {
    "@avesd/configuration": "workspace:*",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-vite": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "tailwindcss": "catalog:"
  }
}
