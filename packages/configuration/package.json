{
  "name": "@avesd/configuration",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test test/unit/eslint/*.test.mjs test/unit/eslint/rules/*.test.mjs",
    "lint:fix": "eslint . --fix"
  },
  "exports": {
    "./eslint": "./eslint/create-avesd-config.mjs",
    "./typescript/base": "./typescript/tsconfig.base.json",
    "./typescript/node": "./typescript/tsconfig.node.json",
    "./typescript/react": "./typescript/tsconfig.react.json",
    "./vitest": "./vitest/create-vitest-config.ts"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "@eslint/js": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "eslint": ">=10 <11",
    "typescript": ">=6 <7"
  }
}
